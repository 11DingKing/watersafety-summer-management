# Service configuration (all values are examples)
CULTURECAMP_SERVER_PORT=49660
CULTURECAMP_SERVER_READ_TIMEOUT=30s
CULTURECAMP_SERVER_WRITE_TIMEOUT=30s
CULTURECAMP_SERVER_SHUTDOWN_TIMEOUT=15s
CULTURECAMP_STORAGE_DATA_DIR=./data
CULTURECAMP_STORAGE_SHARD_MAX_SIZE=1048576
CULTURECAMP_STORAGE_SYNC_ON_WRITE=true
CULTURECAMP_SCHEDULER_ESCALATION_INTERVAL=30s
CULTURECAMP_SCHEDULER_RECONCILIATION_INTERVAL=5m
CULTURECAMP_SCHEDULER_REEVAL_INTERVAL=1m
CULTURECAMP_SCHEDULER_MAX_RETRIES=3
CULTURECAMP_SCHEDULER_BASE_BACKOFF=1s
CULTURECAMP_SCHEDULER_TASK_TIMEOUT=10s
CULTURECAMP_LOGGING_LEVEL=info
CULTURECAMP_LOGGING_FORMAT=json
CULTURECAMP_BUSINESS_DEFAULT_DEADLINE=72h
CULTURECAMP_BUSINESS_ESCALATION_DEADLINE_EXTENSION=48h
CULTURECAMP_BUSINESS_MAX_ESCALATION_LEVEL=3
