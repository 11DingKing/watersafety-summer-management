# Service configuration (all values are examples)
WATERSAFETY_SERVER_PORT=49660
WATERSAFETY_SERVER_READ_TIMEOUT=30s
WATERSAFETY_SERVER_WRITE_TIMEOUT=30s
WATERSAFETY_SERVER_SHUTDOWN_TIMEOUT=15s
WATERSAFETY_STORAGE_DATA_DIR=./data
WATERSAFETY_STORAGE_SHARD_MAX_SIZE=1048576
WATERSAFETY_STORAGE_SYNC_ON_WRITE=true
WATERSAFETY_SCHEDULER_ESCALATION_INTERVAL=30s
WATERSAFETY_SCHEDULER_RECONCILIATION_INTERVAL=5m
WATERSAFETY_SCHEDULER_REEVAL_INTERVAL=1m
WATERSAFETY_SCHEDULER_MAX_RETRIES=3
WATERSAFETY_SCHEDULER_BASE_BACKOFF=1s
WATERSAFETY_SCHEDULER_TASK_TIMEOUT=10s
WATERSAFETY_LOGGING_LEVEL=info
WATERSAFETY_LOGGING_FORMAT=json
WATERSAFETY_BUSINESS_DEFAULT_DEADLINE=72h
WATERSAFETY_BUSINESS_ESCALATION_DEADLINE_EXTENSION=48h
WATERSAFETY_BUSINESS_MAX_ESCALATION_LEVEL=3
